{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{UNET_NAME}}",
      "weight_dtype": "default"
    },
    "_meta": {"title": "MiniMax H3 hybrid FL2VA/Ref2VA"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{CLIP_NAME}}",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {"title": "MiniMax H3 text encoder"}
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "{{VIDEO_VAE_NAME}}"},
    "_meta": {"title": "MiniMax H3 video VAE"}
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "{{AUDIO_VAE_NAME}}"},
    "_meta": {"title": "MiniMax H3 audio VAE"}
  },
  "17": {
    "class_type": "MiniMaxH3MemoryEfficientSageAttentionPatch",
    "inputs": {"model": ["1", 0]},
    "_meta": {"title": "SageAttention"}
  },
  "18": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["17", 0],
      "lora_name": "{{LORA_NAME}}",
      "strength_model": "{{LORA_STRENGTH}}"
    },
    "_meta": {"title": "8-step Turbo LoRA"}
  },
  "15": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{FIRST_FRAME}}"},
    "_meta": {"title": "MCP first frame"}
  },
  "16": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{LAST_FRAME}}"},
    "_meta": {"title": "MCP last frame"}
  },
  "5": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "{{H3_PROMPT}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{NUM_FRAMES}}",
      "first_frame": ["15", 0],
      "last_frame": ["16", 0]
    },
    "_meta": {"title": "MiniMax H3 T2V / I2V conditioning"}
  },
  "6": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": "{{SEED}}"}
  },
  "7": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "{{SAMPLER_NAME}}"}
  },
  "8": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["18", 0],
      "scheduler": "{{SCHEDULER_NAME}}",
      "steps": "{{STEPS}}",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["18", 0],
      "conditioning": ["5", 0]
    }
  },
  "10": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["6", 0],
      "guider": ["9", 0],
      "sampler": ["7", 0],
      "sigmas": ["8", 0],
      "latent_image": ["5", 1]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["10", 0], "vae": ["3", 0]}
  },
  "12": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["10", 0], "vae": ["4", 0]}
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "audio": ["12", 0],
      "fps": 24.0,
      "bit_depth": 8
    }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "video/MiniMax_H3_MCP",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {"title": "Save MCP MP4"}
  }
}
