[Unit]
Description=MiniMax H3 MCP video generation service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/opt/minimax-h3-mcp
EnvironmentFile=/etc/minimax-h3-mcp.env
ExecStart=/home/clhh/minimax-h3-mcp/.venv/bin/python -m minimax_h3_mcp
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
