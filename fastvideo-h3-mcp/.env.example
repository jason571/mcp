# MCP endpoint: http://192.168.108.50:8765/mcp
FASTVIDEO_MCP_HOST=0.0.0.0
FASTVIDEO_MCP_PORT=8765
FASTVIDEO_MCP_PATH=/mcp
FASTVIDEO_MCP_PUBLIC_BASE_URL=http://192.168.108.50:8765

# Explicit Host allowlist for MCP DNS-rebinding protection.
FASTVIDEO_MCP_ALLOWED_HOSTS=192.168.108.50,192.168.108.50:8765,localhost:8765,127.0.0.1:8765
FASTVIDEO_MCP_ALLOWED_ORIGINS=

# Generate strong, independent secrets on the server. Do not commit them.
FASTVIDEO_MCP_API_TOKEN=replace-with-a-long-random-token
FASTVIDEO_MCP_ARTIFACT_SIGNING_KEY=replace-with-an-independent-long-random-key
FASTVIDEO_MCP_ARTIFACT_URL_TTL_SECONDS=3600

FASTVIDEO_MCP_DATA_DIR=/home/clhh/fastvideo-h3-mcp/var
FASTVIDEO_MCP_OUTPUT_DIR=/home/clhh/fastvideo-h3-mcp/var/outputs
FASTVIDEO_MCP_MAX_CONCURRENT_JOBS=1
FASTVIDEO_MCP_PROGRESS_HEARTBEAT_SECONDS=5
FASTVIDEO_MCP_JOB_TIMEOUT_SECONDS=3600
# One generate_video call. Independent of FASTVIDEO_MCP_WARM_MAX_DURATION_SECONDS.
FASTVIDEO_MCP_DEFAULT_DURATION_SECONDS=15
FASTVIDEO_MCP_MAX_DURATION_SECONDS=60
# Do not start a 40-60 GiB model worker while ComfyUI or another CUDA job is active.
FASTVIDEO_RESOURCE_ADMISSION_ENABLED=true
FASTVIDEO_RESOURCE_ADMISSION_POLL_SECONDS=5
FASTVIDEO_RESOURCE_ADMISSION_READY_SAMPLES=2
FASTVIDEO_RESOURCE_ADMISSION_MAX_GPU_USED_MIB=4096
FASTVIDEO_RESOURCE_ADMISSION_MIN_SYSTEM_AVAILABLE_MIB=45000
FASTVIDEO_NVIDIA_SMI_BINARY=nvidia-smi

# Use "mock" for local MCP/progress testing, then switch to "fastvideo-cli" on the GPU server.
FASTVIDEO_MCP_BACKEND=auto
FASTVIDEO_REPO=/home/clhh/FastVideo
FASTVIDEO_PYTHON=/home/clhh/FastVideo/.venv/bin/python
FASTVIDEO_SCRIPT=/home/clhh/FastVideo/examples/inference/basic/basic_minimax_h3_t2v.py
FASTVIDEO_MODEL_PATH=/home/clhh/.cache/modelscope/models/FastVideo--FastVideo-FastH3-4-step-Preview-v1-VSA-DataFree/snapshots/master
FASTVIDEO_MODEL_ID=fasth3-4-step-preview-v1-vsa-datafree
FASTVIDEO_NUM_GPUS=1
# RTX PRO 6000 Blackwell uses VSA-H3's Triton path; sm100a targets B200/GB200.
FASTVIDEO_ATTENTION_BACKEND=VIDEO_SPARSE_ATTN_H3
# Dense FastH3 only. Ignored while VIDEO_SPARSE_ATTN_H3 is selected.
FASTVIDEO_SAGE_ATTENTION=auto
FASTVIDEO_VSA_SPARSITY=0.9
FASTVIDEO_VSA_TILE_SIZE=64
FASTVIDEO_VSA_KERNEL=triton
# VSA-only memory controls. Dense subprocesses force both settings off.
FASTVIDEO_VSA_CACHE_TILE_BUFFER=false
FASTVIDEO_VSA_ATTENTION_RESIDUAL_CHUNK_TOKENS=32768
FASTVIDEO_ENABLE_FA4=false
FASTVIDEO_TORCH_COMPILE=false
# Required on the 60 GiB RAM / 96 GiB VRAM host after applying the bundled patch.
FASTVIDEO_DIRECT_DEVICE_LOAD=true
FASTVIDEO_TEXT_ENCODER_FP8=true
# One MCP subprocess renders one clip; discard the completed DiT before VAE decode.
FASTVIDEO_MINIMAX_H3_RELEASE_DIT_AFTER_DENOISE=true

# Operator-controlled arguments only. They are passed without a shell.
FASTVIDEO_EXTRA_ARGS_JSON=[]

# Base FL2VA runs directly through FastVideo; ComfyUI is not part of production.
MINIMAX_H3_PYTHON=/home/clhh/FastVideo/.venv/bin/python
MINIMAX_H3_MODEL_PATH=/mnt/data/models/MiniMax-H3-r16
# LightX2V 544p FL2VA/T2VA 8-step Turbo. ComfyUI fused qkv_proj is rewritten
# to FastVideo Diffusers to_q/k/v in the Base worker before load.
MINIMAX_H3_LORA_PATH=/mnt/data/ComfyUI-aki-v3/ComfyUI/models/loras/minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
MINIMAX_H3_LORA_ALPHA=8
MINIMAX_H3_LORA_STRENGTH=1.0
MINIMAX_H3_STEPS=8
# Used only by the optional bare-Base Diffusers/ComfyUI compatibility backends.
MINIMAX_H3_LEGACY_STEPS=20
MINIMAX_H3_TEXT_ENCODER_FP8=true
MINIMAX_H3_DIRECT_DEVICE_LOAD=true
MINIMAX_H3_RELEASE_DIT_AFTER_DENOISE=true
MINIMAX_H3_FF_CHUNK_TOKENS=32768
MINIMAX_H3_BASE_BACKEND=fastvideo-native

# Optional legacy backend only. These values are ignored by fastvideo-native.
COMFYUI_BASE_URL=http://127.0.0.1:8189
COMFYUI_MODELS_DIR=/mnt/data/ComfyUI-aki-v3/ComfyUI/models
COMFYUI_T2VA_WORKFLOW_TEMPLATE=/home/clhh/fastvideo-h3-mcp/workflows/video_minimax_h3_t2va_api.json
COMFYUI_FL2VA_WORKFLOW_TEMPLATE=/home/clhh/fastvideo-h3-mcp/workflows/video_minimax_h3_fl2va_api.json
# These may point to one common template; absent keyframe nodes are pruned before submission.
COMFYUI_FIRST_FRAME_WORKFLOW_TEMPLATE=/home/clhh/fastvideo-h3-mcp/workflows/video_minimax_h3_fl2va_api.json
COMFYUI_LAST_FRAME_WORKFLOW_TEMPLATE=/home/clhh/fastvideo-h3-mcp/workflows/video_minimax_h3_fl2va_api.json
COMFYUI_FIRST_LAST_WORKFLOW_TEMPLATE=/home/clhh/fastvideo-h3-mcp/workflows/video_minimax_h3_fl2va_api.json
COMFYUI_API_KEY=
# /interrupt is global to the ComfyUI process. Leave false if other users share it.
COMFYUI_ALLOW_INTERRUPT=false
COMFYUI_UNLOAD_AFTER_JOB=true

# Used to remove the audio track when audio_enabled=false on the FastH3 path.
FFMPEG_BINARY=ffmpeg
FASTVIDEO_MCP_MAX_REFERENCE_IMAGE_BYTES=20971520
