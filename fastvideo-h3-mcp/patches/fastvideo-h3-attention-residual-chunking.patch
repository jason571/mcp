+def _configured_vsa_attention_residual_chunk_tokens() -> int:
+    raw = os.getenv("FASTVIDEO_VSA_ATTENTION_RESIDUAL_CHUNK_TOKENS", "0").strip()
+    try:
+        value = int(raw)
+    except ValueError as exc:
+        raise ValueError(
+            "FASTVIDEO_VSA_ATTENTION_RESIDUAL_CHUNK_TOKENS must be an integer"
+        ) from exc
+    if value < 0:
+        raise ValueError(
+            "FASTVIDEO_VSA_ATTENTION_RESIDUAL_CHUNK_TOKENS must be greater than or equal to zero"
+        )
+    return value
