Z_IMAGE_MODEL_PATH=/path/to/Z-Image-Turbo
Z_IMAGE_DATA_DIR=var
Z_IMAGE_HOST=127.0.0.1
Z_IMAGE_PORT=8766
# Must be reachable from MCP clients (no /mcp suffix).
Z_IMAGE_PUBLIC_URL=http://127.0.0.1:8766
# Optional shared bearer token for trusted clients. Empty means trusted network only.
Z_IMAGE_API_TOKEN=
Z_IMAGE_DEVICE=cuda:0
Z_IMAGE_DTYPE=bfloat16
Z_IMAGE_CPU_OFFLOAD=false
Z_IMAGE_IDLE_UNLOAD_SECONDS=120
Z_IMAGE_MAX_PIXELS=2097152
Z_IMAGE_MAX_PENDING_JOBS=16
Z_IMAGE_MIN_FREE_DISK_MB=512
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
